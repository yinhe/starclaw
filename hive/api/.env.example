# ──── Hive Controller Configuration ────

# Domain & network
HIVE_DOMAIN=starclaw.me
HIVE_PUBLIC_IP=                          # server public IP for DNS A records

# Database
HIVE_MYSQL_ROOT_PASS=hive_prod_2026
HIVE_REDIS_PASSWORD=hive_redis_2026

# Overlord connection
HIVE_OVERLORD_URL=https://overlord.starclaw.net
HIVE_OVERLORD_TOKEN=

# Encryption (Carapace vault)
HIVE_MASTER_KEY=                         # 64-char hex, leave empty for ephemeral

# Queen billing (StarAI payment)
HIVE_QUEEN_URL=https://queen.starclaw.net
HIVE_QUEEN_TOKEN=                        # internal service token

# Aliyun ECS (for pro/enterprise plans)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=cn-shanghai
ALIYUN_VPC_ID=
ALIYUN_VSWITCH_ID=
ALIYUN_SECURITY_GROUP_ID=
ALIYUN_IMAGE_ID=                         # Claw pre-baked AMI

# Aliyun DNS
ALIYUN_DNS_DOMAIN=starclaw.me

# Admin
HIVE_ADMIN_TOKEN=hive-admin-secret-change-me
HIVE_FREE_EXPIRE_DAYS=7
HIVE_MAX_FREE=100

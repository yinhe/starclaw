# ==================================================================
# StarClaw Production — 全局环境变量
# ==================================================================
#
#  服务器 A  starclaw.me         → Claw (开源官网 + app + api)
#  服务器 B  star-ai.net         → Router/Extractor (AI 算力平台)
#  服务器 C  starclaw.net        → Queen (中央控制)
#  服务器 D  proxy.star-ai.net   → Proxy (海外中转节点)
#
#  用法: cp .env.production.example .env.production 然后填入真实密钥
# ==================================================================

# ===================== 服务器 IP =====================
CLAW_SERVER_IP=starclaw.me
STARAI_SERVER_IP=<STARAI_IP>
STARAI_PROXY_IP=<STARAI_PROXY_IP>
QUEEN_SERVER_IP=<QUEEN_IP>

# ===================== 通用安全 =====================
JWT_SECRET=<GENERATE: openssl rand -hex 32>

# ==================== 服务器 A: Claw (starclaw.me) ====================
# 域名: starclaw.me / app.starclaw.me / api.starclaw.me
# docker-compose: 根目录 docker-compose.prod.yml
DB_ROOT_PASSWORD=<STRONG_PASSWORD>
STARCLAW_SERVER_MODE=release
STARCLAW_SERVER_DEPLOY_MODE=hosted
OPENAI_API_KEY=<YOUR_OPENAI_KEY>

# Platform shared keys (hosted 模式，用户无自有 key 时使用)
PLATFORM_QWEN_API_KEY=<YOUR_DASHSCOPE_KEY>
PLATFORM_OPENAI_API_KEY=<YOUR_OPENAI_KEY>
PLATFORM_DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_KEY>
PLATFORM_FAL_API_KEY=<YOUR_FAL_KEY>

# ==================== 服务器 B: Router (star-ai.net) ====================
# 域名: star-ai.net / api.star-ai.net
# docker-compose: router/docker-compose.yml
# SSH: ssh -i ~/.ssh/starai_deploy root@<STARAI_IP>
STARAI_SSH_KEY=~/.ssh/starai_deploy
STARAI_SSH_USER=root
STARAI_SSH_HOST=<STARAI_IP>
MYSQL_ROOT_PASSWORD=<STRONG_PASSWORD>
PROXY_INTERNAL_SECRET=<GENERATE: openssl rand -hex 16>

# 国内 Provider (Go API 直连)
DASHSCOPE_API_KEY=<YOUR_DASHSCOPE_KEY>
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_KEY>

# 海外 Provider (通过 Server D Proxy 中转)
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_KEY>
GOOGLE_API_KEY=<YOUR_GOOGLE_KEY>
FAL_API_KEY=<YOUR_FAL_KEY>
RUNWAYML_API_SECRET=<YOUR_RUNWAYML_KEY>

# 支付宝 (env prefix: STAR_AI_ALIPAY_)
STAR_AI_ALIPAY_APP_ID=<YOUR_ALIPAY_APP_ID>
STAR_AI_ALIPAY_IS_PRODUCTION=true

# 微信支付 (env prefix: STAR_AI_WECHAT_)
STAR_AI_WECHAT_APP_ID=<YOUR_WECHAT_APP_ID>
STAR_AI_WECHAT_MCH_ID=<YOUR_WECHAT_MCH_ID>
STAR_AI_WECHAT_MCH_SERIAL_NO=<YOUR_MCH_SERIAL_NO>
STAR_AI_WECHAT_APIV3_KEY=<YOUR_APIV3_KEY>

# Grok 多 Key 轮转
GROK_API_KEY_1=<YOUR_GROK_KEY>
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_API_KEY_4=
GROK_API_KEY_5=

# ==================== 服务器 A: Claw (starclaw.me) ====================
# SSH: ssh -i ~/.ssh/claw_deploy root@starclaw.me
CLAW_SSH_KEY=~/.ssh/claw_deploy
CLAW_SSH_USER=root
CLAW_SSH_HOST=starclaw.me

# ==================== 服务器 D: Proxy (proxy.star-ai.net) ====================
# 域名: proxy.star-ai.net
# 海外节点，中转 OpenAI / Anthropic / Google / Grok / fal / RunwayML
# SSH: ssh -i ~/.ssh/starai_proxy_deploy root@<STARAI_PROXY_IP>
STARAI_PROXY_SSH_KEY=~/.ssh/starai_proxy_deploy
STARAI_PROXY_SSH_USER=root
STARAI_PROXY_SSH_HOST=<STARAI_PROXY_IP>

# ==================== 服务器 C: Queen (starclaw.net) ====================
# 域名: starclaw.net / swarm.starclaw.net / bounty.starclaw.net
#        forum.starclaw.net / arena.starclaw.net / core.starclaw.net
# docker-compose: queen/docker-compose.prod.yml
# SSH: ssh -i ~/.ssh/queen_deploy root@<QUEEN_IP>
QUEEN_SSH_KEY=~/.ssh/queen_deploy
QUEEN_SSH_USER=root
QUEEN_SSH_HOST=<QUEEN_IP>
QUEEN_DB_PASSWORD=<STRONG_PASSWORD>
GRAFANA_USER=admin
GRAFANA_PASSWORD=<STRONG_PASSWORD>

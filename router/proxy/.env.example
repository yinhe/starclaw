# OpenAI API 配置
API_KEY=your_openai_api_key_here

# Fal AI 配置
FAL_KEY=your_fal_api_key_here

# RunwayML 配置
RUNWAYML_API_SECRET=your_runwayml_api_secret_here

# Grok API 配置（仅支持 Grok-4 系列：grok-4-0709, grok-4, grok-4-latest）
GROK_API_KEY_4=your_grok_api_key_here
GROK_BASE_URL_4=https://api.x.ai/v1

# 服务器配置
PORT=8000

# Redis 配置 (如果使用)
REDIS_URL=redis://localhost:6379

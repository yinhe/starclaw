# StarClaw Environment Variables
# Copy this file to .env and fill in your values

# JWT Secret (MUST change in production)
JWT_SECRET=change-me-in-production

# OpenAI API Key (required for RAG embeddings)
OPENAI_API_KEY=sk-xxx

# Database (defaults work with docker-compose)
# STARCLAW_DATABASE_HOST=localhost
# STARCLAW_DATABASE_PORT=3306
# STARCLAW_DATABASE_USER=root
# STARCLAW_DATABASE_PASSWORD=starclaw
# STARCLAW_DATABASE_DBNAME=starclaw

# Redis (defaults work with docker-compose)
# STARCLAW_REDIS_HOST=localhost
# STARCLAW_REDIS_PORT=6379

# Server
# STARCLAW_SERVER_PORT=8080
# STARCLAW_SERVER_MODE=debug
# STARCLAW_SERVER_DEPLOY_MODE=opensource  # hosted = 官网托管(有计费), opensource = 开源自部署(无计费)

# Platform shared API Keys (only needed when deploy_mode=hosted)
# Users without their own key will use these; billing applies.
# PLATFORM_QWEN_API_KEY=sk-xxx
# PLATFORM_OPENAI_API_KEY=sk-xxx
# PLATFORM_FAL_API_KEY=xxx
# PLATFORM_DEEPSEEK_API_KEY=sk-xxx

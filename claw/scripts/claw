#!/usr/bin/env bash
# ============================================================
# StarClaw CLI — shortcut for daily operations
# Usage: claw <command> [args...]
#
# Install:
#   sudo ln -sf $(pwd)/scripts/claw /usr/local/bin/claw
#   sudo ln -sf $(pwd)/scripts/claw /usr/local/bin/starclaw
#
# Then use from anywhere:
#   claw up          — build & start all services
#   claw logs        — follow logs
#   claw ps          — show running containers
#   starclaw update  — pull latest & rebuild
# ============================================================

set -e

# Auto-detect project root (where docker-compose.yml lives)
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# If we're not in the project dir, cd into it
cd "$PROJECT_ROOT"

# Colors
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
  # ---- Build & Start ----
  up)
    echo -e "${GREEN}🦞 Starting StarClaw...${NC}"
    make up
    ;;
  up-cn)
    echo -e "${GREEN}🦞 Starting StarClaw (China mirror)...${NC}"
    make up-cn
    ;;
  start)
    make start
    ;;
  stop)
    echo -e "${YELLOW}Stopping StarClaw...${NC}"
    make stop
    ;;
  restart)
    make restart
    ;;
  down)
    make down
    ;;
  destroy)
    echo -e "${RED}⚠️  This will delete ALL data. Are you sure? [y/N]${NC}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      make destroy
    else
      echo "Cancelled."
    fi
    ;;

  # ---- Logs ----
  logs)
    make logs
    ;;
  logs-api|log|la)
    make logs-api
    ;;
  logs-web|lw)
    make logs-web
    ;;
  logs-mysql|lm)
    make logs-mysql
    ;;
  logs-redis|lr)
    make logs-redis
    ;;

  # ---- Status ----
  ps|status)
    make ps
    ;;
  stats)
    make stats
    ;;
  health|ping)
    make health
    ;;

  # ---- Update ----
  update|pull)
    echo -e "${GREEN}🦞 Updating StarClaw...${NC}"
    make update
    ;;
  update-cn)
    make update-cn
    ;;

  # ---- Rebuild ----
  rebuild-api|ra)
    echo -e "${CYAN}Rebuilding API...${NC}"
    make rebuild-api
    ;;
  rebuild-web|rw)
    echo -e "${CYAN}Rebuilding Web...${NC}"
    make rebuild-web
    ;;

  # ---- Backup & Restore ----
  backup)
    make backup
    ;;
  restore-db)
    make restore-db FILE="$1"
    ;;

  # ---- Shell ----
  shell|sh)
    make shell-api
    ;;
  mysql)
    make shell-mysql
    ;;
  redis)
    make shell-redis
    ;;

  # ---- Cleanup ----
  prune|clean)
    make prune
    ;;
  init)
    make init
    ;;

  # ---- Version ----
  version|v|-v|--version)
    echo -e "${GREEN}StarClaw CLI${NC}"
    curl -sf http://localhost:8080/v1/version 2>/dev/null | python3 -m json.tool 2>/dev/null || echo "API not running — check with: claw ps"
    ;;

  # ---- Help ----
  help|-h|--help|"")
    echo -e "${GREEN}🦞 StarClaw CLI${NC} — Daily operations made easy"
    echo ""
    echo -e "${CYAN}Usage:${NC} claw <command>"
    echo -e "       starclaw <command>"
    echo ""
    echo -e "${CYAN}Lifecycle:${NC}"
    echo "  up            Build and start all services"
    echo "  up-cn         Build and start (China mirror)"
    echo "  start         Start existing containers"
    echo "  stop          Stop all containers"
    echo "  restart       Restart all containers"
    echo "  down          Stop and remove containers"
    echo "  destroy       Stop, remove, AND delete data ⚠️"
    echo ""
    echo -e "${CYAN}Logs:${NC}"
    echo "  logs          Follow all logs"
    echo "  logs-api, la  Follow API logs"
    echo "  logs-web, lw  Follow Web logs"
    echo "  logs-mysql    Follow MySQL logs"
    echo "  logs-redis    Follow Redis logs"
    echo ""
    echo -e "${CYAN}Status:${NC}"
    echo "  ps, status    Show running containers"
    echo "  stats         Show CPU/MEM usage"
    echo "  health, ping  Check API health"
    echo "  version, v    Show version info"
    echo ""
    echo -e "${CYAN}Update:${NC}"
    echo "  update, pull  Pull latest + rebuild"
    echo "  update-cn     Pull + rebuild (China)"
    echo "  rebuild-api   Rebuild API only"
    echo "  rebuild-web   Rebuild Web only"
    echo ""
    echo -e "${CYAN}Data:${NC}"
    echo "  backup        Backup database + data"
    echo "  restore-db    Restore from backup"
    echo ""
    echo -e "${CYAN}Shell:${NC}"
    echo "  shell, sh     Open API container shell"
    echo "  mysql         Open MySQL CLI"
    echo "  redis         Open Redis CLI"
    echo ""
    echo -e "${CYAN}Other:${NC}"
    echo "  init          First-time setup"
    echo "  prune, clean  Remove unused Docker images"
    echo ""
    ;;

  # ---- Fallback: pass to make ----
  *)
    echo -e "${YELLOW}Passing to make: $CMD $@${NC}"
    make "$CMD" "$@"
    ;;
esac

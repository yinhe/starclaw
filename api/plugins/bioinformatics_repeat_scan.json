{
  "name": "bioinformatics_repeat_scan",
  "description": "Scan nucleotide or protein sequences for simple tandem repeats across configurable motif sizes and repeat thresholds.",
  "version": "1.0.0",
  "author": "StarClaw Bioinformatics Clinic",
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "const": "repeat_scan" },
      "sequence": { "type": "string" },
      "sequence_name": { "type": "string" },
      "sequence_type_hint": { "type": "string" },
      "motif_sizes": { "type": "string" },
      "min_repeat_count": { "type": "integer" }
    },
    "required": ["sequence"]
  },
  "handler": "bioinformatics_clinic",
  "metadata": { "category": "medical", "timeout": 20 }
}

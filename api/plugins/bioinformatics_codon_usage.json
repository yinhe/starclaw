{
  "name": "bioinformatics_codon_usage",
  "description": "Compute codon frequencies, GC3, and amino-acid-level summary from a DNA or RNA sequence in a selected reading frame.",
  "version": "1.0.0",
  "author": "StarClaw Bioinformatics Clinic",
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "const": "codon_usage" },
      "sequence": { "type": "string" },
      "sequence_name": { "type": "string" },
      "sequence_type_hint": { "type": "string" },
      "frame": { "type": "integer" }
    },
    "required": ["sequence"]
  },
  "handler": "bioinformatics_clinic",
  "metadata": { "category": "medical", "timeout": 20 }
}

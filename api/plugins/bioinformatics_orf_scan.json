{
  "name": "bioinformatics_orf_scan",
  "description": "Scan DNA or RNA sequence input for candidate open reading frames across reading frames and optionally the reverse strand.",
  "version": "1.0.0",
  "author": "StarClaw Bioinformatics Clinic",
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "const": "orf_scan" },
      "sequence": { "type": "string" },
      "sequence_name": { "type": "string" },
      "sequence_type_hint": { "type": "string" },
      "min_aa_length": { "type": "integer" },
      "scan_reverse": { "type": "boolean" }
    },
    "required": ["sequence"]
  },
  "handler": "bioinformatics_clinic",
  "metadata": { "category": "medical", "timeout": 20 }
}

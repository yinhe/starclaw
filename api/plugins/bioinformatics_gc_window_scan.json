{
  "name": "bioinformatics_gc_window_scan",
  "description": "Scan a DNA or RNA sequence with sliding windows to summarize local GC-rich and GC-poor regions.",
  "version": "1.0.0",
  "author": "StarClaw Bioinformatics Clinic",
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "const": "gc_window_scan" },
      "sequence": { "type": "string" },
      "sequence_name": { "type": "string" },
      "sequence_type_hint": { "type": "string" },
      "window_size": { "type": "integer" },
      "step_size": { "type": "integer" }
    },
    "required": ["sequence"]
  },
  "handler": "bioinformatics_clinic",
  "metadata": { "category": "medical", "timeout": 20 }
}

{
  "name": "mental_health_school_stress_review",
  "description": "Review school stress using school avoidance, peer conflict, academic decline, bullying concerns, and crisis signals.",
  "version": "1.0.0",
  "author": "StarClaw Mental Health Clinic",
  "parameters": {
    "type": "object",
    "properties": {
      "action": { "type": "string", "const": "school_stress_review" },
      "age_years": { "type": "number" },
      "school_avoidance": { "type": "boolean" },
      "peer_conflict": { "type": "boolean" },
      "academic_decline": { "type": "boolean" },
      "bullying_concern": { "type": "boolean" },
      "symptoms": { "type": "array", "items": { "type": "string" } }
    }
  },
  "handler": "mental_health_clinic",
  "metadata": { "category": "medical", "timeout": 10 }
}

ARG REGISTRY=docker.io
FROM ${REGISTRY}/golang:1.24-alpine AS builder

WORKDIR /app

# Use China Go proxy if GOPROXY is set (pass --build-arg GOPROXY=https://goproxy.cn,direct)
ARG GOPROXY=
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Ensure embedded web dist exists (placeholder for go:embed if web not pre-built)
RUN mkdir -p internal/web/dist && \
    [ -z "$(ls -A internal/web/dist 2>/dev/null)" ] && echo "placeholder" > internal/web/dist/.keep || true

# ── CI quality gate: vet + test ──
RUN go vet ./... && \
    go test ./internal/security/... ./internal/agent/... ./internal/webhook/... ./internal/inference/... ./internal/middleware/... -count=1 -timeout=60s && \
    echo "✅ All tests passed"

ARG BUILD_VERSION=
RUN VERSION="$BUILD_VERSION" && \
    # 1. Read from .version file (generated by deploy scripts before build) 
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then \
      [ -f .version ] && VERSION=$(cat .version | tr -d '\n\r '); \
    fi && \
    # 2. Try git tag from .git-version (if present) 
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then \
      [ -f ../.git-version ] && VERSION=$(cat ../.git-version | tr -d '\n\r '); \
    fi && \
    # 3. Nydus API (our own server, fast in China) 
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then \
      VERSION=$(wget -qO- -T 5 "https://nydus.starclaw.net/releases/latest" 2>/dev/null \
        | grep -o '"tag_name":"[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//' || true); \
    fi && \
    # 4. GitHub API fallback 
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then \
      VERSION=$(wget -qO- -T 8 "https://api.github.com/repos/yinhe/starclaw/releases/latest" 2>/dev/null \
        | grep -o '"tag_name":"[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//' || true); \
    fi && \
    # 5. UTC timestamp as last resort (NEVER "dev") 
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then VERSION=$(date -u +"%Y.%m%d.%H%M"); fi && \
    echo "Building with version: $VERSION" && \
    CGO_ENABLED=0 GOOS=linux go build -ldflags "-X github.com/yinhe/starclaw/internal/molt.Version=${VERSION}" -o /starclaw ./cmd/server && \
    echo "Cross-compiling MCP Bridge for all platforms..." && \
    BRIDGE_LDFLAGS="-X main.version=${VERSION}" && \
    CGO_ENABLED=0 GOOS=darwin  GOARCH=amd64 go build -ldflags "$BRIDGE_LDFLAGS" -o /mcp-bridge-darwin-amd64   ./cmd/mcp-bridge/ && \
    CGO_ENABLED=0 GOOS=darwin  GOARCH=arm64 go build -ldflags "$BRIDGE_LDFLAGS" -o /mcp-bridge-darwin-arm64   ./cmd/mcp-bridge/ && \
    CGO_ENABLED=0 GOOS=linux   GOARCH=amd64 go build -ldflags "$BRIDGE_LDFLAGS" -o /mcp-bridge-linux-amd64   ./cmd/mcp-bridge/ && \
    CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags "$BRIDGE_LDFLAGS" -o /mcp-bridge-windows-amd64.exe ./cmd/mcp-bridge/ && \
    echo "MCP Bridge binaries built for 4 platforms"

ARG REGISTRY=docker.io
FROM ${REGISTRY}/alpine:latest

# Use Alibaba Cloud mirrors for faster downloads in China (skip on GitHub Actions)
ARG USE_CN_MIRROR=false
RUN if [ "$USE_CN_MIRROR" = "true" ]; then \
      sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories; \
    fi

# Core + Browser + FFmpeg + Python + Node.js (one layer)
RUN apk --no-cache add \
    ca-certificates tzdata bash curl wget git unzip \
    chromium nss freetype harfbuzz font-noto-cjk ffmpeg libass \
    python3 py3-pip py3-setuptools \
    nodejs npm \
    docker-cli docker-cli-compose \
    openssh-client \
    && PIP_ARGS=""; NPM_REG=""; \
    if [ "$USE_CN_MIRROR" = "true" ]; then \
      PIP_ARGS="-i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com"; \
      NPM_REG="https://registry.npmmirror.com"; \
    fi \
    && python3 -m pip install --break-system-packages $PIP_ARGS flask fastapi uvicorn requests beautifulsoup4 aiohttp dashscope python-pptx openpyxl \
    && if [ -n "$NPM_REG" ]; then npm config set registry "$NPM_REG"; fi \
    && npm install -g yarn pnpm typescript ts-node

# Go (copy from builder)
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/tmp/gopath"
ENV CHROME_BIN=/usr/bin/chromium-browser

ENV TZ=Asia/Shanghai
ENV PIP_BREAK_SYSTEM_PACKAGES=1
WORKDIR /app

# These layers change on every code update (fast, no package installs)
COPY --from=builder /starclaw .
COPY --from=builder /mcp-bridge-* ./mcp-bridge/
COPY configs/config.yaml ./configs/
COPY plugins/ ./plugins/
COPY scripts/ ./scripts/

EXPOSE 8080

CMD ["./starclaw"]

# Claw Lite — Spore + SQLite + Web UI, single container
# Used for Spark tier (free forever)

# Stage 0: Build web frontend
FROM node:20-alpine AS build-web
WORKDIR /web
COPY claw/web/package.json claw/web/package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com && \
    npm install --legacy-peer-deps
COPY claw/web/ ./
RUN npm run build

# Stage 1: Build claw-api binary (needs CGO for SQLite, embeds web dist)
FROM golang:1.24-alpine AS build-claw
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY claw/api/ ./
COPY --from=build-web /web/dist ./internal/web/dist
ARG BUILD_VERSION=
RUN VERSION="$BUILD_VERSION" && \
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then [ -f .version ] && VERSION=$(cat .version | tr -d '\n\r '); fi && \
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then VERSION=$(wget -qO- -T 5 "https://nydus.starclaw.net/releases/latest" 2>/dev/null | grep -o '"tag_name":"[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//' || true); fi && \
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then VERSION=$(wget -qO- -T 8 "https://api.github.com/repos/yinhe/starclaw/releases/latest" 2>/dev/null | grep -o '"tag_name":"[^"]*"' | head -1 | cut -d'"' -f4 | sed 's/^v//' || true); fi && \
    if [ -z "$VERSION" ] || [ "$VERSION" = "dev" ]; then VERSION=$(date -u +"%Y.%m%d.%H%M"); fi && \
    echo "Building claw-api with version: $VERSION" && \
    CGO_ENABLED=1 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X github.com/yinhe/starclaw/internal/molt.Version=${VERSION}" -o /claw-api ./cmd/server

# Stage 2: Build spore binary
FROM golang:1.24-alpine AS build-spore
WORKDIR /src
COPY spore/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /spore ./cmd/spore

# Stage 3: Minimal runtime
FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=Asia/Shanghai

WORKDIR /opt/claw

COPY --from=build-claw /claw-api ./claw-api
COPY --from=build-spore /spore /usr/bin/spore

# Spore manifest for claw-lite
COPY claw/lite-manifest.json ./manifest.json

# Data volume for SQLite + identity keys
VOLUME /opt/claw/data

ENV STARCLAW_DATABASE_DRIVER=sqlite \
    STARCLAW_DATABASE_SQLITE_PATH=/opt/claw/data/claw.db \
    STARCLAW_REDIS_ENABLED=false \
    STARCLAW_SERVER_MODE=release \
    STARCLAW_SERVER_PORT=8080 \
    GIN_MODE=release

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s \
    CMD wget -q -O /dev/null http://localhost:8080/health || exit 1

ENTRYPOINT ["spore", "run-inline", "/opt/claw"]

#!/usr/bin/env bash
# ============================================================
# StarClaw Queen CLI — shortcut for Queen service operations
# Usage: queen <command> [args...]
#
# Install:
#   sudo ln -sf $(pwd)/scripts/queen /usr/local/bin/queen
#
# Then use from anywhere:
#   queen up       — build & start all Queen services
#   queen logs     — follow logs
#   queen ps       — show running containers
#   queen health   — check all services
# ============================================================

set -e

REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

COMPOSE="docker compose -f docker-compose.prod.yml"

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
  # ---- Lifecycle ----
  up)
    echo -e "${GREEN}👑 Starting Queen services...${NC}"
    $COMPOSE up -d --build
    ;;
  down)
    $COMPOSE down
    ;;
  start)
    $COMPOSE start
    ;;
  stop)
    echo -e "${YELLOW}Stopping Queen services...${NC}"
    $COMPOSE stop
    ;;
  restart)
    $COMPOSE restart
    ;;
  destroy)
    echo -e "${RED}⚠️  This will delete ALL Queen data. Are you sure? [y/N]${NC}"
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      $COMPOSE down
      rm -rf data/mysql
      echo "Destroyed."
    else
      echo "Cancelled."
    fi
    ;;

  # ---- Deploy ----
  deploy)
    echo -e "${GREEN}👑 Full Queen deployment...${NC}"
    bash deploy/deploy.sh
    ;;

  # ---- Logs ----
  logs)
    $COMPOSE logs -f --tail 100
    ;;
  logs-swarm|ls)
    $COMPOSE logs -f --tail 200 swarm
    ;;
  logs-core|lc)
    $COMPOSE logs -f --tail 200 core
    ;;
  logs-bounty|lb)
    $COMPOSE logs -f --tail 200 bounty
    ;;
  logs-forum|lf)
    $COMPOSE logs -f --tail 200 forum
    ;;
  logs-arena|la)
    $COMPOSE logs -f --tail 200 arena
    ;;
  logs-mysql|lm)
    $COMPOSE logs -f --tail 100 mysql-queen
    ;;

  # ---- Status ----
  ps|status)
    $COMPOSE ps
    ;;
  stats)
    docker stats --no-stream starclaw-queen-swarm starclaw-queen-core starclaw-queen-bounty starclaw-queen-forum starclaw-queen-arena starclaw-queen-mysql
    ;;
  health|ping)
    echo -e "${CYAN}Checking Queen services...${NC}"
    services=("swarm:8090" "core:8091" "bounty:8092" "forum:8093" "arena:8094")
    for svc in "${services[@]}"; do
      name="${svc%%:*}"
      port="${svc##*:}"
      resp=$(curl -sf "http://127.0.0.1:$port/health" 2>/dev/null || echo "")
      if [ -n "$resp" ]; then
        echo -e "  ${GREEN}✓${NC} $name (:$port) — OK"
      else
        echo -e "  ${RED}✗${NC} $name (:$port) — DOWN"
      fi
    done
    ;;

  # ---- Update ----
  update|pull)
    echo -e "${GREEN}👑 Updating Queen...${NC}"
    git pull
    $COMPOSE up -d --build
    ;;
  rebuild)
    $COMPOSE up -d --build --force-recreate
    ;;

  # ---- Backup ----
  backup)
    mkdir -p backups
    docker exec starclaw-queen-mysql mysqldump -uroot -p"${QUEEN_DB_PASSWORD:-starclaw_queen_2026}" starclaw_queen > "backups/queen_$(date +%Y%m%d_%H%M%S).sql"
    echo -e "${GREEN}✓ Backup saved to backups/${NC}"
    ;;
  restore-db)
    if [ -z "$1" ]; then
      echo "Usage: queen restore-db <file.sql>"
      exit 1
    fi
    docker exec -i starclaw-queen-mysql mysql -uroot -p"${QUEEN_DB_PASSWORD:-starclaw_queen_2026}" starclaw_queen < "$1"
    echo -e "${GREEN}✓ Restored from $1${NC}"
    ;;

  # ---- Shell ----
  mysql)
    docker exec -it starclaw-queen-mysql mysql -uroot -p"${QUEEN_DB_PASSWORD:-starclaw_queen_2026}" starclaw_queen
    ;;
  shell|sh)
    docker exec -it starclaw-queen-swarm sh
    ;;

  # ---- Help ----
  help|-h|--help|"")
    echo -e "${GREEN}👑 StarClaw Queen CLI${NC} — Service operations"
    echo ""
    echo -e "${CYAN}Usage:${NC} queen <command>"
    echo ""
    echo -e "${CYAN}Lifecycle:${NC}"
    echo "  deploy        Full deployment (SSL + Nginx + build)"
    echo "  up            Build and start all services"
    echo "  stop          Stop all services"
    echo "  restart       Restart all services"
    echo "  down          Stop and remove containers"
    echo "  destroy       Stop + delete all data"
    echo ""
    echo -e "${CYAN}Logs:${NC}"
    echo "  logs          Follow all logs"
    echo "  logs-swarm    Follow swarm logs (alias: ls)"
    echo "  logs-core     Follow core logs (alias: lc)"
    echo "  logs-bounty   Follow bounty logs (alias: lb)"
    echo "  logs-forum    Follow forum logs (alias: lf)"
    echo "  logs-arena    Follow arena logs (alias: la)"
    echo "  logs-mysql    Follow MySQL logs (alias: lm)"
    echo ""
    echo -e "${CYAN}Status:${NC}"
    echo "  ps, status    Show running containers"
    echo "  stats         CPU/MEM usage"
    echo "  health, ping  Check all service health"
    echo ""
    echo -e "${CYAN}Update:${NC}"
    echo "  update, pull  Git pull + rebuild all"
    echo "  rebuild       Force rebuild all"
    echo ""
    echo -e "${CYAN}Data:${NC}"
    echo "  backup        Backup MySQL"
    echo "  restore-db    Restore from SQL file"
    echo ""
    echo -e "${CYAN}Shell:${NC}"
    echo "  mysql         Open MySQL CLI"
    echo "  shell, sh     Open swarm container shell"
    echo ""
    ;;

  *)
    echo -e "${YELLOW}Unknown command: $CMD — passing to docker compose${NC}"
    $COMPOSE "$CMD" "$@"
    ;;
esac

{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Service Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },

    {
      "title": "Swarm Online Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [{ "expr": "queen_swarm_online_nodes", "legendFormat": "nodes" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Heartbeats / min",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "targets": [{ "expr": "rate(queen_swarm_heartbeats_total[5m]) * 60", "legendFormat": "hb/min" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Star Energy Grants / min",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(queen_credit_grants_total[5m]) * 60", "legendFormat": "grants/min" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Active Credit Accounts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "targets": [{ "expr": "queen_credit_active_accounts", "legendFormat": "accounts" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "none" }
    },

    {
      "title": "Queen Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(queen_http_requests_total[5m])) by (job)", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "title": "Queen Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(queen_http_requests_total{status=~\"5..\"}[5m])) by (job)", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } } }
    },

    {
      "title": "Queen P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(queen_http_request_duration_seconds_bucket[5m])) by (job, le))", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } } }
    },
    {
      "title": "Queen In-Flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "queen_http_requests_in_flight", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 } } }
    },

    {
      "title": "Star Energy Economy",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(queen_credit_grant_amount_units[5m]) / 10000", "legendFormat": "Grants (Stars/s)" },
        { "expr": "rate(queen_credit_consume_amount_units[5m]) / 10000", "legendFormat": "Consumes (Stars/s)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "title": "Billing Recharges",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "sum(increase(queen_billing_recharges_total[1h])) by (status)", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1 } } }
    },

    {
      "title": "Claw Chat Requests (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "sum(rate(starclaw_chat_requests_total[5m])) by (provider)", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "title": "Claw Chat P95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(starclaw_chat_latency_seconds_bucket[5m])) by (provider, le))", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 30 }] } } }
    },

    {
      "title": "Claw Token Usage (tokens/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "sum(rate(starclaw_tokens_used_total[5m])) by (type)", "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "title": "Claw Tool Calls (calls/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "sum(rate(starclaw_tool_calls_total[5m])) by (tool)", "legendFormat": "{{tool}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },

    {
      "title": "Claw Star Energy Balance",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 48 },
      "targets": [{ "expr": "starclaw_star_energy_balance", "legendFormat": "Balance" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 100 }] }, "min": 0, "max": 1000 } }
    },
    {
      "title": "Claw HP %",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 48 },
      "targets": [{ "expr": "starclaw_star_energy_hp_percent", "legendFormat": "HP" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 25 }, { "color": "green", "value": 50 }] }, "min": 0, "max": 100 } }
    },
    {
      "title": "Claw WebSocket / SSE Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 48 },
      "targets": [{ "expr": "starclaw_websocket_connections_active", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Claw Agent Tasks",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 48 },
      "targets": [
        { "expr": "sum(rate(starclaw_agent_tasks_total{status=\"ok\"}[5m])) * 60", "legendFormat": "ok/min" },
        { "expr": "sum(rate(starclaw_agent_tasks_total{status=\"error\"}[5m])) * 60", "legendFormat": "err/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 } },
      "options": { "colorMode": "value", "graphMode": "area" }
    },

    {
      "title": "Process Memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
      "title": "Go Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "targets": [{ "expr": "go_goroutines", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 2000 }] } } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["starclaw", "queen", "claw"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "StarClaw Overview",
  "uid": "starclaw-overview",
  "version": 2
}

# ============================================================
# StarClaw Overlord — 环境变量配置
# 复制此文件为 .env 并修改为实际值
# cp .env.example .env
# ============================================================

# ── MySQL ──
OVERLORD_MYSQL_PASSWORD=starclaw_prod_secret

# ── API 服务 ──
OVERLORD_ADMIN_USERNAME=admin
OVERLORD_ADMIN_PASSWORD=change-me-to-a-strong-password
OVERLORD_MAX_NODES=10
# Community=10, Starter=20, Pro=100, Enterprise=500, 0=unlimited

# ── 端口映射 ──
OVERLORD_API_PORT=8098
OVERLORD_CONSOLE_PORT=3095
OVERLORD_WEB_PORT=3096

# ── SSO (可选) ──
# OVERLORD_SSO_OAUTH2_CLIENT_ID=
# OVERLORD_SSO_OAUTH2_CLIENT_SECRET=
# OVERLORD_SSO_LDAP_HOST=ldap.example.com:389
# OVERLORD_SSO_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# OVERLORD_SSO_LDAP_BIND_PASS=

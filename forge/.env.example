# ── Auth ──
# JWT signing secret (change this!)
FORGE_SECRET=your-strong-random-secret-here
# Whitelist: node_id:password pairs, comma separated
# Only whitelisted nodes can login to Forge dashboard
FORGE_WHITELIST=admin:changeme123,yinhe:mypassword

# ── LLM ──
FORGE_LLM_API_KEY=sk-xxx
FORGE_LLM_MODEL=deepseek-chat
FORGE_LLM_BASE_URL=https://api.star-ai.net/v1

# ── Services ──
NYDUS_URL=https://nydus.starclaw.net
OVERLORD_URL=http://overlord-api:8095
DEVBRIDGE_URL=http://host.docker.internal:9102
PHEROMONE_NATS_URL=nats://pheromone-nats:4222

#!/bin/bash
# Nydus post-receive hook: auto-deploy on push to master
# Location: /data/nydus/repos/starclaw.git/hooks/post-receive

REPO=/data/nydus/repos/starclaw.git
CLAW_REPO=/data/nydus/repos/claw.git
LOG=/var/log/nydus-deploy.log
SERVER_A="root@starclaw.me"
SERVER_B="root@47.103.51.32"
SSH_KEY="/home/git/.ssh/id_ed25519"
SSH_OPTS="-i $SSH_KEY -o StrictHostKeyChecking=no -o ConnectTimeout=10"

while read oldrev newrev refname; do
  # Sync tags to claw.git (for Molt release detection)
  case "$refname" in
    refs/tags/v*)
      tag=$(echo "$refname" | sed 's|refs/tags/||')
      if [ -d "$CLAW_REPO" ]; then
        git --git-dir="$CLAW_REPO" tag "$tag" "$newrev" 2>/dev/null && \
          echo "[nydus] synced tag $tag to claw.git" || \
          echo "[nydus] tag $tag already exists in claw.git"
      fi

      # Auto cross-compile binaries for Spore update & download page
      # Uses Docker golang image (Go/Node not installed on host)
      echo "$(date '+%Y-%m-%d %H:%M:%S') [release] Building binaries for $tag..." | tee -a "$LOG"
      (
        BUILD_DIR=$(mktemp -d)
        RELEASE_DIR="/opt/releases/binary/$tag"
        mkdir -p "$RELEASE_DIR"

        # Extract claw source
        git --git-dir="$REPO" archive "$newrev":claw/ | tar xf - -C "$BUILD_DIR"

        # Create minimal web placeholder for go:embed (full web is in Docker image)
        mkdir -p "$BUILD_DIR/api/internal/web/dist"
        echo '<!DOCTYPE html><html><head><meta charset="utf-8"><title>StarClaw</title></head><body></body></html>' \
          > "$BUILD_DIR/api/internal/web/dist/index.html"

        # Cross-compile all platforms using Docker golang image
        VER="${tag#v}"
        docker run --rm \
          -v "$BUILD_DIR/api:/src" \
          -v "$RELEASE_DIR:/out" \
          -w /src \
          golang:1.24-alpine sh -c "
            LDFLAGS='-X github.com/yinhe/starclaw/internal/molt.Version=$VER'
            for pair in linux:amd64 linux:arm64 darwin:amd64 darwin:arm64 windows:amd64; do
              os_name=\${pair%%:*}
              arch_name=\${pair##*:}
              outname=starclaw-\${os_name}-\${arch_name}
              [ \"\$os_name\" = windows ] && outname=\"\${outname}.exe\"
              echo \"  Building \$outname (v$VER)...\"
              GOOS=\$os_name GOARCH=\$arch_name CGO_ENABLED=0 \
                go build -ldflags \"\$LDFLAGS\" -o /out/\$outname ./cmd/server 2>&1 || \
                echo \"  WARN: failed to build \$outname\"
            done
            ls -lh /out/
          "

        rm -rf "$BUILD_DIR"
        echo "$(date '+%Y-%m-%d %H:%M:%S') [release] Binaries for $tag ready in $RELEASE_DIR" | tee -a "$LOG"
        ls -lh "$RELEASE_DIR/" 2>/dev/null || true
      ) >> "$LOG" 2>&1 &

      continue
      ;;
  esac

  branch=$(git rev-parse --symbolic --abbrev-ref "$refname" 2>/dev/null || echo "$refname")
  if [ "$branch" != "master" ] && [ "$branch" != "refs/heads/master" ]; then
    continue
  fi

  echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Push to master: $oldrev -> $newrev" | tee -a "$LOG"

  # Detect which directories changed
  CHANGED=$(git --git-dir="$REPO" diff --name-only "$oldrev" "$newrev" 2>/dev/null || echo "all")

  # --- Queen (Server C — local + Server A for site) ---
  if echo "$CHANGED" | grep -q "^queen/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Queen changed — rebuilding..." | tee -a "$LOG"
    (
      cd /opt/starclaw-queen
      git --git-dir="$REPO" archive HEAD:queen | tar xf - 2>/dev/null || true

      if echo "$CHANGED" | grep -q "^queen/api/"; then
        docker compose -f docker-compose.prod.yml build --no-cache queen-api
        docker compose -f docker-compose.prod.yml up -d queen-api
        echo "  -> queen-api rebuilt (Server C)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/swarm/"; then
        docker compose -f docker-compose.prod.yml build --no-cache swarm
        docker compose -f docker-compose.prod.yml up -d swarm
        echo "  -> queen-swarm rebuilt (Server C)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/web/"; then
        docker compose -f docker-compose.prod.yml build --no-cache queen-web
        docker compose -f docker-compose.prod.yml up -d queen-web
        echo "  -> queen-web rebuilt (Server C)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/core/"; then
        docker compose -f docker-compose.prod.yml build --no-cache queen-core
        docker compose -f docker-compose.prod.yml up -d queen-core
        echo "  -> queen-core rebuilt (Server C)" | tee -a "$LOG"
      fi

      # Deploy queen/site to Server A (starclaw.me — nginx root: /opt/starclaw/queen/site)
      if echo "$CHANGED" | grep -q "^queen/site/"; then
        echo "  -> deploying queen-site to starclaw.me (Server A)..." | tee -a "$LOG"
        # 1. Ship source to a build directory on Server A
        git --git-dir="$REPO" archive HEAD:queen/site | ssh $SSH_OPTS "$SERVER_A" "rm -rf /tmp/queen-site-build && mkdir -p /tmp/queen-site-build && cd /tmp/queen-site-build && tar xf -"
        # 2. Build with Docker (node:20-alpine), output goes to /tmp/queen-site-build/dist
        ssh $SSH_OPTS "$SERVER_A" "cd /tmp/queen-site-build && docker run --rm -v \$(pwd):/app -w /app node:20-alpine sh -c 'npm ci --registry=https://registry.npmmirror.com && npm run build'"
        # 3. Atomic swap: replace nginx root with fresh dist
        ssh $SSH_OPTS "$SERVER_A" "rm -rf /opt/starclaw/queen/site-old && mv /opt/starclaw/queen/site /opt/starclaw/queen/site-old 2>/dev/null; mv /tmp/queen-site-build/dist /opt/starclaw/queen/site && rm -rf /tmp/queen-site-build"
        echo "  -> queen-site deployed to starclaw.me (static files updated)" | tee -a "$LOG"
      fi
    ) >> "$LOG" 2>&1 &
  fi

  # --- Claw (Server A — starclaw.me) ---
  if echo "$CHANGED" | grep -q "^claw/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Claw changed — deploying to starclaw.me..." | tee -a "$LOG"
    (
      git --git-dir="$REPO" archive HEAD:claw | ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw && tar xf -"
      ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw && bash scripts/server-deploy-update.sh all --no-pull"
      echo "  -> claw deployed to starclaw.me (starclaw-api:latest rebuilt)" | tee -a "$LOG"
      # Upgrade all Hive instances to use the new starclaw-api:latest image
      ssh $SSH_OPTS "$SERVER_A" 'curl -sf -X POST http://localhost:9090/hive/admin/upgrade-instances -H "Authorization: Bearer $HIVE_ADMIN_TOKEN"' >> "$LOG" 2>&1 || true
      echo "  -> hive instances upgrade triggered" | tee -a "$LOG"
    ) >> "$LOG" 2>&1 &
  fi

  # --- Hive controller (Server A) ---
  if echo "$CHANGED" | grep -q "^hive/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Hive changed — rebuilding on starclaw.me..." | tee -a "$LOG"
    (
      git --git-dir="$REPO" archive HEAD:hive | ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw-hive && tar xf -"
      git --git-dir="$REPO" archive HEAD:carapace | ssh $SSH_OPTS "$SERVER_A" "mkdir -p /opt/starclaw-hive/carapace && cd /opt/starclaw-hive/carapace && tar xf -"
      ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw-hive && docker compose -f docker-compose.hive.yml build --no-cache controller && docker compose -f docker-compose.hive.yml up -d controller"
      echo "  -> hive-controller rebuilt on Server A" | tee -a "$LOG"
    ) >> "$LOG" 2>&1 &
  fi

  # --- Synapse (Server B — star-ai.net) ---
  if echo "$CHANGED" | grep -q "^synapse/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Synapse changed — deploying to server B..." | tee -a "$LOG"
    (
      git --git-dir="$REPO" archive HEAD:synapse | ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && tar xf -"

      if echo "$CHANGED" | grep -q "^synapse/api/\|^synapse/docker-compose"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache api && docker compose up -d api"
        echo "  -> synapse-api rebuilt on B (star-ai-api :8096)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/web/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache web && docker compose up -d web"
        echo "  -> synapse-web rebuilt on B (star-ai-web :3096)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/core/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache core && docker compose up -d core"
        echo "  -> synapse-core rebuilt on B (star-ai-core :3097 → core.star-ai.net)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/proxy/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache proxy && docker compose up -d proxy"
        echo "  -> synapse-proxy rebuilt on B (overseas relay)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/deploy/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && cp deploy/nginx-starai.conf /etc/nginx/sites-available/star-ai 2>/dev/null; nginx -t && systemctl reload nginx" || true
        echo "  -> synapse nginx config updated on B" | tee -a "$LOG"
      fi
    ) >> "$LOG" 2>&1 &
  fi

  # --- Overlord (Server C — local) ---
  if echo "$CHANGED" | grep -q "^overlord/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Overlord changed — rebuilding on server C..." | tee -a "$LOG"
    (
      mkdir -p /opt/starclaw-overlord
      cd /opt/starclaw-overlord
      git --git-dir="$REPO" archive HEAD:overlord | tar xf - 2>/dev/null || true
      docker compose -f docker-compose.prod.yml up -d --build api console web
      echo "  -> overlord rebuilt" | tee -a "$LOG"
    ) >> "$LOG" 2>&1 &
  fi

  # --- Forge (Server C — local) ---
  if echo "$CHANGED" | grep -q "^forge/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Forge changed — rebuilding on server C..." | tee -a "$LOG"
    (
      mkdir -p /opt/starclaw-forge
      cd /opt/starclaw-forge
      git --git-dir="$REPO" archive HEAD:forge | tar xf - 2>/dev/null || true

      if echo "$CHANGED" | grep -q "^forge/api/"; then
        docker compose build --no-cache forge-api
        docker compose up -d forge-api
        echo "  -> forge-api rebuilt (Server C :8099)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^forge/web/"; then
        docker compose build --no-cache forge-web
        docker compose up -d forge-web
        echo "  -> forge-web rebuilt (Server C :3099)" | tee -a "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^forge/docker-compose"; then
        docker compose up -d
        echo "  -> forge compose refreshed" | tee -a "$LOG"
      fi
    ) >> "$LOG" 2>&1 &
  fi

  # --- Nydus config (reload if changed) ---
  if echo "$CHANGED" | grep -q "^nydus/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Nydus config changed — syncing..." | tee -a "$LOG"
    (
      cd /opt/nydus
      git --git-dir="$REPO" archive HEAD:nydus | tar xf - 2>/dev/null || true
      docker compose restart api
      echo "  -> nydus config synced & api restarted" | tee -a "$LOG"
    ) >> "$LOG" 2>&1 &
  fi

  echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Background deploy started for: $CHANGED" | tee -a "$LOG"
done

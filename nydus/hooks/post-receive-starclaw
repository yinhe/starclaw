#!/bin/bash
# Nydus post-receive hook: auto-deploy on push to master + polyrepo sync
# Location: /data/nydus/repos/starclaw.git/hooks/post-receive

REPO=/data/nydus/repos/starclaw.git
CLAW_REPO=/data/nydus/repos/claw.git
LOG=/var/log/nydus-deploy.log
SERVER_A="root@starclaw.me"
SERVER_B="root@47.103.51.32"
SSH_KEY="/home/git/.ssh/id_ed25519"
SSH_OPTS="-i $SSH_KEY -o StrictHostKeyChecking=no -o ConnectTimeout=10"
PHEROMONE_NATS_HOST="127.0.0.1"
PHEROMONE_NATS_PORT="4222"
NYDUS_API="http://127.0.0.1:8098"
NYDUS_SECRET="nydus-sc2026-vKwRmT9xLpQjN3hB"
ENABLE_REMOTE_FORGE_DEPLOY="${ENABLE_REMOTE_FORGE_DEPLOY:-0}"

# Report deploy result to Nydus API for dashboard display
report_deploy_result() {
  local repo="$1" branch="$2" rev="$3" target="$4" status="$5" msg="$6"
  local ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  curl -sf -X POST "${NYDUS_API}/hooks/deploy-report?secret=${NYDUS_SECRET}" \
    -H "Content-Type: application/json" \
    -d "[{\"repo\":\"${repo}\",\"branch\":\"${branch}\",\"rev\":\"${rev}\",\"target\":\"${target}\",\"status\":\"${status}\",\"message\":\"${msg}\",\"timestamp\":\"${ts}\"}]" \
    >/dev/null 2>&1 || true
}

publish_pheromone_deploy() {
  service="$1"
  branch="$2"
  commit="$3"

  payload=$(printf '{"event":"deploy.triggered","repo":"starclaw","service":"%s","branch":"%s","commit":"%s","actor":"nydus"}' "$service" "$branch" "$commit")
  subject="pheromone.events.deploy.$service"
  bytes=${#payload}

  (
    exec 3<>/dev/tcp/$PHEROMONE_NATS_HOST/$PHEROMONE_NATS_PORT || exit 0
    printf 'CONNECT {"verbose":false,"pedantic":false}\r\n' >&3
    printf 'PUB %s %s\r\n%s\r\n' "$subject" "$bytes" "$payload" >&3
    exec 3>&-
  ) >/dev/null 2>&1 &
}

publish_pheromone_deploy_result() {
  service="$1"
  status="$2"       # completed | failed
  duration="$3"
  error_msg="$4"

  subject="pheromone.events.nydus.deploy.$status"
  payload=$(printf '{"service":"%s","status":"%s","duration":"%s","error":"%s","actor":"nydus"}' "$service" "$status" "$duration" "$error_msg")
  bytes=${#payload}

  (
    exec 3<>/dev/tcp/$PHEROMONE_NATS_HOST/$PHEROMONE_NATS_PORT || exit 0
    printf 'CONNECT {"verbose":false,"pedantic":false}\r\n' >&3
    printf 'PUB %s %s\r\n%s\r\n' "$subject" "$bytes" "$payload" >&3
    exec 3>&-
  ) >/dev/null 2>&1 &
}

# ========== Polyrepo Sync (monorepo subdir → individual bare repos) ==========
# Each push to master auto-syncs changed subdirectories to their polyrepo on Nydus
# claw uses sync_claw_to_oss (main branch + OSS files preserved + GitHub push)
POLYREPO_SERVICES="queen hive synapse overlord pheromone forge nydus carapace cerebrate larva spore"

# Sync monorepo claw/ → claw.git (OSS repo, main branch)
# Preserves OSS-only files (LICENSE, .github/, CONTRIBUTING, docker-compose, etc.)
# Then pushes to GitHub if remote is configured
sync_claw_to_oss() {
  local msg="$1"
  [ ! -d "$CLAW_REPO" ] && return 0

  local tmpdir=$(mktemp -d)

  # Step 1: Extract current claw.git main (has OSS files: LICENSE, .github, etc.)
  git --git-dir="$CLAW_REPO" archive refs/heads/main 2>/dev/null | tar xf - -C "$tmpdir" 2>/dev/null || true

  # Step 2: Overlay monorepo claw/ on top (updates code, preserves OSS-only files)
  git --git-dir="$REPO" archive "${newrev}:claw" 2>/dev/null | tar xf - -C "$tmpdir" 2>/dev/null || true

  if [ -z "$(ls -A "$tmpdir" 2>/dev/null)" ]; then
    rm -rf "$tmpdir"
    return 0
  fi

  local idx=$(mktemp)
  rm -f "$idx"

  export GIT_DIR="$CLAW_REPO"
  export GIT_WORK_TREE="$tmpdir"
  export GIT_INDEX_FILE="$idx"
  export GIT_AUTHOR_NAME="Nydus Sync"
  export GIT_AUTHOR_EMAIL="nydus@starclaw.net"
  export GIT_COMMITTER_NAME="Nydus Sync"
  export GIT_COMMITTER_EMAIL="nydus@starclaw.net"

  git add -A 2>/dev/null

  if git diff --cached --quiet refs/heads/main 2>/dev/null; then
    rm -f "$idx"; rm -rf "$tmpdir"
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    return 0
  fi

  local tree=$(git write-tree)
  local parent=$(git rev-parse refs/heads/main 2>/dev/null) || true
  local new_commit
  if [ -n "$parent" ]; then
    new_commit=$(echo "$msg" | git commit-tree "$tree" -p "$parent")
  else
    new_commit=$(echo "$msg" | git commit-tree "$tree")
  fi
  git update-ref refs/heads/main "$new_commit"

  rm -f "$idx"; rm -rf "$tmpdir"
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

  echo "$(date '+%Y-%m-%d %H:%M:%S') [sync] claw.git (OSS) main updated (${new_commit:0:7})"

  # Push to GitHub (requires: git --git-dir=$CLAW_REPO remote add github git@github.com:yinhe/starclaw.git)
  if git --git-dir="$CLAW_REPO" remote get-url github >/dev/null 2>&1; then
    GIT_SSH_COMMAND="ssh -i $SSH_KEY -o StrictHostKeyChecking=no" \
      git --git-dir="$CLAW_REPO" push github main 2>/dev/null && \
      echo "$(date '+%Y-%m-%d %H:%M:%S') [sync] claw.git → GitHub pushed" || \
      echo "$(date '+%Y-%m-%d %H:%M:%S') [sync] claw.git → GitHub push failed"
  fi
}

sync_to_polyrepo() {
  local subdir="$1"
  local polyrepo="/data/nydus/repos/${subdir}.git"
  local msg="$2"

  [ ! -d "$polyrepo" ] && return 0

  local tmpdir=$(mktemp -d)

  # Export subdirectory tree from monorepo
  git --git-dir="$REPO" archive "${newrev}:${subdir}" 2>/dev/null | tar xf - -C "$tmpdir" 2>/dev/null || true
  if [ -z "$(ls -A "$tmpdir" 2>/dev/null)" ]; then
    rm -rf "$tmpdir"
    return 0
  fi

  # Use separate index to avoid conflicts with concurrent operations
  local idx=$(mktemp)
  rm -f "$idx"  # Remove empty file so git creates a valid index from scratch

  export GIT_DIR="$polyrepo"
  export GIT_WORK_TREE="$tmpdir"
  export GIT_INDEX_FILE="$idx"
  export GIT_AUTHOR_NAME="Nydus Sync"
  export GIT_AUTHOR_EMAIL="nydus@starclaw.net"
  export GIT_COMMITTER_NAME="Nydus Sync"
  export GIT_COMMITTER_EMAIL="nydus@starclaw.net"

  # Stage all files
  git add -A 2>/dev/null

  # Skip if polyrepo HEAD tree is already identical
  if git diff --cached --quiet HEAD 2>/dev/null; then
    rm -f "$idx"; rm -rf "$tmpdir"
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    return 0
  fi

  # Create tree → commit → update ref (pure git plumbing, no working copy needed)
  local tree=$(git write-tree)
  local parent=""
  parent=$(git rev-parse refs/heads/master 2>/dev/null) || true
  local new_commit
  if [ -n "$parent" ]; then
    new_commit=$(echo "$msg" | git commit-tree "$tree" -p "$parent")
  else
    new_commit=$(echo "$msg" | git commit-tree "$tree")
  fi
  git update-ref refs/heads/master "$new_commit"

  rm -f "$idx"; rm -rf "$tmpdir"
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

  echo "$(date '+%Y-%m-%d %H:%M:%S') [sync] ${subdir}.git updated (${new_commit:0:7})"
}

# Read all refs from stdin FIRST (git writes multiple lines for multi-commit push)
REFS=""
while read oldrev newrev refname; do
  REFS="${REFS}${oldrev} ${newrev} ${refname}\n"
done

# Fork entire processing into background so git push returns immediately
(
exec >>"$LOG" 2>&1

echo "$REFS" | while read oldrev newrev refname; do
  [ -z "$oldrev" ] && continue
  # Sync tags to claw.git (for Molt release detection)
  case "$refname" in
    refs/tags/v*)
      tag=$(echo "$refname" | sed 's|refs/tags/||')
      if [ -d "$CLAW_REPO" ]; then
        git --git-dir="$CLAW_REPO" tag "$tag" "$newrev" 2>/dev/null && \
          echo "[nydus] synced tag $tag to claw.git" || \
          echo "[nydus] tag $tag already exists in claw.git"
      fi

      # Auto cross-compile binaries for Spore update & download page
      # Uses Docker golang image (Go/Node not installed on host)
      echo "$(date '+%Y-%m-%d %H:%M:%S') [release] Building binaries for $tag..." | cat >> "$LOG"
      (
        BUILD_DIR=$(mktemp -d)
        RELEASE_DIR="/opt/releases/binary/$tag"
        mkdir -p "$RELEASE_DIR"

        # Extract claw source
        git --git-dir="$REPO" archive "$newrev":claw/ | tar xf - -C "$BUILD_DIR"

        # Create minimal web placeholder for go:embed (full web is in Docker image)
        mkdir -p "$BUILD_DIR/api/internal/web/dist"
        echo '<!DOCTYPE html><html><head><meta charset="utf-8"><title>StarClaw</title></head><body></body></html>' \
          > "$BUILD_DIR/api/internal/web/dist/index.html"

        # Cross-compile all platforms using Docker golang image
        VER="${tag#v}"
        docker run --rm \
          -v "$BUILD_DIR/api:/src" \
          -v "$RELEASE_DIR:/out" \
          -w /src \
          golang:1.24-alpine sh -c "
            LDFLAGS='-X github.com/yinhe/starclaw/internal/molt.Version=$VER'
            for pair in linux:amd64 linux:arm64 darwin:amd64 darwin:arm64 windows:amd64; do
              os_name=\${pair%%:*}
              arch_name=\${pair##*:}
              outname=starclaw-\${os_name}-\${arch_name}
              [ \"\$os_name\" = windows ] && outname=\"\${outname}.exe\"
              echo \"  Building \$outname (v$VER)...\"
              GOOS=\$os_name GOARCH=\$arch_name CGO_ENABLED=0 \
                go build -ldflags \"\$LDFLAGS\" -o /out/\$outname ./cmd/server 2>&1 || \
                echo \"  WARN: failed to build \$outname\"
            done
            ls -lh /out/
          "

        rm -rf "$BUILD_DIR"
        echo "$(date '+%Y-%m-%d %H:%M:%S') [release] Binaries for $tag ready in $RELEASE_DIR" | cat >> "$LOG"
        ls -lh "$RELEASE_DIR/" 2>/dev/null || true
      ) </dev/null >> "$LOG" 2>&1 &

      continue
      ;;
  esac

  branch=$(git rev-parse --symbolic --abbrev-ref "$refname" 2>/dev/null || echo "$refname")
  if [ "$branch" != "master" ] && [ "$branch" != "refs/heads/master" ]; then
    continue
  fi

  echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Push to master: $oldrev -> $newrev" | cat >> "$LOG"

  # Detect which directories changed
  CHANGED=$(git --git-dir="$REPO" diff --name-only "$oldrev" "$newrev" 2>/dev/null || echo "all")

  # --- Queen (Server C — local + Server A for site) ---
  if echo "$CHANGED" | grep -q "^queen/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Queen changed — rebuilding..." | cat >> "$LOG"
    publish_pheromone_deploy "queen" "$branch" "$newrev"
    (
      _start=$SECONDS
      cd /opt/queen
      git --git-dir="$REPO" archive HEAD:queen | tar xf - 2>/dev/null || true

      if echo "$CHANGED" | grep -q "^queen/api/\|^pheromone/sdk/"; then
        # Copy pheromone/sdk into api/ for Docker build context
        mkdir -p /opt/queen/api/pheromone-sdk
        git --git-dir="$REPO" archive HEAD:pheromone/sdk | tar xf - -C /opt/queen/api/pheromone-sdk 2>/dev/null || true
        docker compose -f docker-compose.prod.yml build --no-cache queen-api
        docker compose -f docker-compose.prod.yml up -d queen-api
        echo "  -> queen-api rebuilt (Server C)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/swarm/"; then
        docker compose -f docker-compose.prod.yml build --no-cache swarm
        docker compose -f docker-compose.prod.yml up -d swarm
        echo "  -> queen-swarm rebuilt (Server C)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/web/"; then
        docker compose -f docker-compose.prod.yml build --no-cache queen-web
        docker compose -f docker-compose.prod.yml up -d queen-web
        echo "  -> queen-web rebuilt (Server C)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^queen/core/"; then
        docker compose -f docker-compose.prod.yml build --no-cache queen-core
        docker compose -f docker-compose.prod.yml up -d queen-core
        echo "  -> queen-core rebuilt (Server C)" | cat >> "$LOG"
      fi

      # Deploy queen/site to Server A (starclaw.me — nginx root: /opt/starclaw/queen/site)
      if echo "$CHANGED" | grep -q "^queen/site/"; then
        echo "  -> deploying queen-site to starclaw.me (Server A)..." | cat >> "$LOG"
        # 1. Ship source to a build directory on Server A
        git --git-dir="$REPO" archive HEAD:queen/site | ssh $SSH_OPTS "$SERVER_A" "rm -rf /tmp/queen-site-build && mkdir -p /tmp/queen-site-build && cd /tmp/queen-site-build && tar xf -"
        # 2. Build with Docker (node:20-alpine), output goes to /tmp/queen-site-build/dist
        ssh $SSH_OPTS "$SERVER_A" "cd /tmp/queen-site-build && docker run --rm -v \$(pwd):/app -w /app node:20-alpine sh -c 'npm ci --registry=https://registry.npmmirror.com && npm run build'"
        # 3. Atomic swap: replace nginx root with fresh dist
        ssh $SSH_OPTS "$SERVER_A" "rm -rf /opt/starclaw/queen/site-old && mv /opt/starclaw/queen/site /opt/starclaw/queen/site-old 2>/dev/null; mv /tmp/queen-site-build/dist /opt/starclaw/queen/site && rm -rf /tmp/queen-site-build"
        echo "  -> queen-site deployed to starclaw.me (static files updated)" | cat >> "$LOG"
      fi
      publish_pheromone_deploy_result "queen" "completed" "$((SECONDS - _start))s" ""
      report_deploy_result "starclaw" "$branch" "${newrev:0:7}" "queen-server-c" "success" "deployed in $((SECONDS - _start))s"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Claw (Server A — starclaw.me) ---
  if echo "$CHANGED" | grep -q "^claw/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Claw changed — deploying to starclaw.me..." | cat >> "$LOG"
    publish_pheromone_deploy "claw" "$branch" "$newrev"
    (
      _start=$SECONDS
      git --git-dir="$REPO" archive HEAD:claw | ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw && tar xf -"
      ssh $SSH_OPTS "$SERVER_A" "cd /opt/starclaw && bash scripts/server-deploy-update.sh all --no-pull"
      echo "  -> claw deployed to starclaw.me (starclaw-api:latest rebuilt)" | cat >> "$LOG"
      # Upgrade all Hive instances to use the new starclaw-api:latest image
      ssh $SSH_OPTS "$SERVER_A" 'curl -sf -X POST http://localhost:9090/hive/admin/upgrade-instances -H "Authorization: Bearer $HIVE_ADMIN_TOKEN"' >> "$LOG" 2>&1 || true
      echo "  -> hive instances upgrade triggered" | cat >> "$LOG"
      publish_pheromone_deploy_result "claw" "completed" "$((SECONDS - _start))s" ""
      report_deploy_result "starclaw" "$branch" "${newrev:0:7}" "claw-starclaw-me" "success" "deployed in $((SECONDS - _start))s"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Hive controller (Server A) ---
  if echo "$CHANGED" | grep -q "^hive/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Hive changed — rebuilding on starclaw.me..." | cat >> "$LOG"
    publish_pheromone_deploy "hive" "$branch" "$newrev"
    (
      _start=$SECONDS
      git --git-dir="$REPO" archive HEAD:hive | ssh $SSH_OPTS "$SERVER_A" "cd /opt/hive && tar xf -"
      git --git-dir="$REPO" archive HEAD:carapace | ssh $SSH_OPTS "$SERVER_A" "mkdir -p /opt/carapace && cd /opt/carapace && tar xf -"
      git --git-dir="$REPO" archive HEAD:pheromone/sdk | ssh $SSH_OPTS "$SERVER_A" "mkdir -p /opt/pheromone/sdk && cd /opt/pheromone/sdk && tar xf -"
      ssh $SSH_OPTS "$SERVER_A" "cd /opt/hive && docker compose -f docker-compose.hive.yml build --no-cache controller && docker compose -f docker-compose.hive.yml up -d controller"
      echo "  -> hive-controller rebuilt on Server A" | cat >> "$LOG"
      publish_pheromone_deploy_result "hive" "completed" "$((SECONDS - _start))s" ""
      report_deploy_result "starclaw" "$branch" "${newrev:0:7}" "hive-server-a" "success" "deployed in $((SECONDS - _start))s"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Synapse (Server B — star-ai.net) ---
  if echo "$CHANGED" | grep -q "^synapse/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Synapse changed — deploying to server B..." | cat >> "$LOG"
    publish_pheromone_deploy "synapse" "$branch" "$newrev"
    (
      _start=$SECONDS
      git --git-dir="$REPO" archive HEAD:synapse | ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && tar xf -"

      if echo "$CHANGED" | grep -q "^synapse/api/\|^synapse/docker-compose\|^pheromone/sdk/"; then
        # Copy pheromone/sdk into api/ for Docker build context
        git --git-dir="$REPO" archive HEAD:pheromone/sdk | ssh $SSH_OPTS "$SERVER_B" "mkdir -p /opt/starclaw/synapse/api/pheromone-sdk && cd /opt/starclaw/synapse/api/pheromone-sdk && tar xf -"
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache api && docker compose up -d api"
        echo "  -> synapse-api rebuilt on B (star-ai-api :8096)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/web/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache web && docker compose up -d web"
        echo "  -> synapse-web rebuilt on B (star-ai-web :3096)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/core/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache core && docker compose up -d core"
        echo "  -> synapse-core rebuilt on B (star-ai-core :3097 → core.star-ai.net)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/proxy/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && docker compose build --no-cache proxy && docker compose up -d proxy"
        echo "  -> synapse-proxy rebuilt on B (overseas relay)" | cat >> "$LOG"
      fi
      if echo "$CHANGED" | grep -q "^synapse/deploy/"; then
        ssh $SSH_OPTS "$SERVER_B" "cd /opt/starclaw/synapse && cp deploy/nginx-starai.conf /etc/nginx/sites-available/star-ai 2>/dev/null; nginx -t && systemctl reload nginx" || true
        echo "  -> synapse nginx config updated on B" | cat >> "$LOG"
      fi
      publish_pheromone_deploy_result "synapse" "completed" "$((SECONDS - _start))s" ""
      report_deploy_result "starclaw" "$branch" "${newrev:0:7}" "synapse-server-b" "success" "deployed in $((SECONDS - _start))s"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Overlord (Server C — local) ---
  if echo "$CHANGED" | grep -q "^overlord/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Overlord changed — rebuilding on server C..." | cat >> "$LOG"
    publish_pheromone_deploy "overlord" "$branch" "$newrev"
    (
      _start=$SECONDS
      mkdir -p /opt/overlord
      cd /opt/overlord
      git --git-dir="$REPO" archive HEAD:overlord | tar xf - 2>/dev/null || true
      # Copy pheromone/sdk into api/ for Docker build context
      mkdir -p /opt/overlord/api/pheromone-sdk
      git --git-dir="$REPO" archive HEAD:pheromone/sdk | tar xf - -C /opt/overlord/api/pheromone-sdk 2>/dev/null || true
      docker compose -f docker-compose.prod.yml up -d --build api console web
      echo "  -> overlord rebuilt" | cat >> "$LOG"
      publish_pheromone_deploy_result "overlord" "completed" "$((SECONDS - _start))s" ""
      report_deploy_result "starclaw" "$branch" "${newrev:0:7}" "overlord-server-c" "success" "deployed in $((SECONDS - _start))s"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Pheromone (Server C — local) ---
  if echo "$CHANGED" | grep -q "^pheromone/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Pheromone changed — rebuilding on server C..." | cat >> "$LOG"
    publish_pheromone_deploy "pheromone" "$branch" "$newrev"
    (
      mkdir -p /opt/pheromone
      cd /opt/pheromone
      git --git-dir="$REPO" archive HEAD:pheromone | tar xf - 2>/dev/null || true
      export REGISTRY="${REGISTRY:-docker.1ms.run}"
      docker rm -f pheromone-api pheromone-web pheromone-nats pheromone-nats-exporter >/dev/null 2>&1 || true
      docker compose -f docker-compose.yml up -d --build
      echo "  -> pheromone stack refreshed (Server C :8100/:3110/:4222/:7777)" | cat >> "$LOG"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # --- Forge (Server C — local) ---
  if echo "$CHANGED" | grep -q "^forge/"; then
    if [ "$ENABLE_REMOTE_FORGE_DEPLOY" != "1" ]; then
      echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Forge changed — skipped (remote Forge disabled, using local Forge)" | cat >> "$LOG"
    else
      echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Forge changed — rebuilding on server C..." | cat >> "$LOG"
      publish_pheromone_deploy "forge" "$branch" "$newrev"
      (
        mkdir -p /opt/forge
        cd /opt/forge
        git --git-dir="$REPO" archive HEAD:forge | tar xf - 2>/dev/null || true
        # Copy pheromone/sdk into api/ for Docker build context
        mkdir -p /opt/forge/api/pheromone-sdk
        git --git-dir="$REPO" archive HEAD:pheromone/sdk | tar xf - -C /opt/forge/api/pheromone-sdk 2>/dev/null || true

        if echo "$CHANGED" | grep -q "^forge/api/"; then
          docker compose build --no-cache forge-api
          docker compose up -d forge-api
          echo "  -> forge-api rebuilt (Server C :8099)" | cat >> "$LOG"
        fi
        if echo "$CHANGED" | grep -q "^forge/web/"; then
          docker compose build --no-cache forge-web
          docker compose up -d forge-web
          echo "  -> forge-web rebuilt (Server C :3099)" | cat >> "$LOG"
        fi
        if echo "$CHANGED" | grep -q "^forge/docker-compose"; then
          docker compose up -d
          echo "  -> forge compose refreshed" | cat >> "$LOG"
        fi
      ) </dev/null >> "$LOG" 2>&1 &
    fi
  fi

  # --- Nydus config (reload if changed) ---
  if echo "$CHANGED" | grep -q "^nydus/"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Nydus config changed — syncing..." | cat >> "$LOG"
    publish_pheromone_deploy "nydus" "$branch" "$newrev"
    (
      cd /opt/nydus
      git --git-dir="$REPO" archive HEAD:nydus | tar xf - 2>/dev/null || true
      # Copy pheromone/sdk into api/ for Docker build context (go.mod replace ./pheromone-sdk)
      mkdir -p /opt/nydus/api/pheromone-sdk
      git --git-dir="$REPO" archive HEAD:pheromone/sdk | tar xf - -C /opt/nydus/api/pheromone-sdk 2>/dev/null || true
      docker compose up -d --build api
      echo "  -> nydus config synced & api rebuilt" | cat >> "$LOG"
    ) </dev/null >> "$LOG" 2>&1 &
  fi

  # ========== Sync changed subdirectories to polyrepos ==========
  (
    short_rev=$(echo "$newrev" | head -c 7)
    commit_msg=$(git --git-dir="$REPO" log -1 --format='%s' "$newrev" 2>/dev/null || echo "sync from starclaw")
    sync_msg="sync: ${commit_msg} (${short_rev})"

    synced=""
    for svc in $POLYREPO_SERVICES; do
      if echo "$CHANGED" | grep -q "^${svc}/"; then
        sync_to_polyrepo "$svc" "$sync_msg" && synced="$synced $svc"
      fi
    done

    # Sync claw/ → claw.git OSS repo (main branch, preserves OSS files, pushes to GitHub)
    if echo "$CHANGED" | grep -q "^claw/"; then
      sync_claw_to_oss "$sync_msg" && synced="$synced claw(oss)"
    fi

    if [ -n "$synced" ]; then
      echo "$(date '+%Y-%m-%d %H:%M:%S') [sync] polyrepo sync done:$synced"
    fi
  ) </dev/null >> "$LOG" 2>&1 &

  echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] Background deploy started for: $CHANGED"
done

# Wait for all background deploy jobs to finish before exiting
wait
echo "$(date '+%Y-%m-%d %H:%M:%S') [deploy] All background jobs completed"

) </dev/null &
